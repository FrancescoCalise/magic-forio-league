---
import Layout from "../layouts/Layout.astro";
import {
  stagioneCorrente,
  getSquadreStagioneCorrente,
  getGiocatore,
} from "../lib/data";
import { withBase } from "../lib/url";

const squadreInGara = getSquadreStagioneCorrente();

const stagioneSlug = stagioneCorrente.stagione.replace("/", "-");
const edizioniGiornale = [...stagioneCorrente.giornale].sort(
  (a, b) => b.settimana - a.settimana,
);
---

<Layout
  title={`Stagione ${stagioneCorrente.stagione}`}
  description={`Squadre in gara e giornale settimanale della stagione ${stagioneCorrente.stagione} della Magic Forio League.`}
>
  <section class="border-b border-border px-6 py-16 text-center">
    <h1 class="font-display text-6xl tracking-wide text-foreground">
      Stagione {stagioneCorrente.stagione}
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-muted-foreground">
      Le squadre in gara e il giornale settimanale della lega.
    </p>
  </section>

  <section class="border-b border-border px-6 py-16">
    <div class="mx-auto max-w-6xl">
      <h2 class="mb-8 text-center font-display text-3xl tracking-wide text-foreground">
        Squadre in gara
      </h2>
      {
        squadreInGara.length === 0 ? (
          <p class="text-center text-muted-foreground">
            Le squadre iscritte a questa stagione saranno annunciate a breve.
          </p>
        ) : (
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {squadreInGara.map((squadra) => {
              const giocatore = getGiocatore(squadra.giocatoreId);
              return (
                <div class="flex items-center gap-4 rounded-lg border border-border bg-card p-4">
                  <img
                    src={withBase(giocatore.immagine)}
                    alt={`Foto di ${giocatore.nome}`}
                    width="48"
                    height="48"
                    loading="lazy"
                    class="h-12 w-12 shrink-0 rounded-full border-2 border-accent object-cover"
                  />
                  <div class="min-w-0 flex-1">
                    <p class="truncate font-display text-xl tracking-wide text-foreground">
                      {squadra.nome}
                    </p>
                    <p class="truncate text-sm text-muted-foreground">{giocatore.nome}</p>
                  </div>
                  {squadra.logo && (
                    <img
                      src={withBase(squadra.logo)}
                      alt={`Stemma ${squadra.nome}`}
                      width="40"
                      height="40"
                      loading="lazy"
                      class="h-10 w-10 shrink-0 rounded-full border border-border object-cover"
                    />
                  )}
                </div>
              );
            })}
          </div>
        )
      }
    </div>
  </section>

  <section class="px-6 py-16">
    <div class="mx-auto max-w-2xl">
      <h2 class="mb-8 text-center font-display text-3xl tracking-wide text-foreground">
        Il Giornale della Lega
      </h2>
      {
        edizioniGiornale.length === 0 ? (
          <p class="text-center text-muted-foreground">
            Il giornale settimanale sarà pubblicato qui a partire dalla prima
            giornata.
          </p>
        ) : (
          <div data-giornale>
            <div class="mb-4 flex items-center justify-between gap-4">
              <button
                type="button"
                data-giornale-prev
                aria-label="Giornata precedente"
                class="cursor-pointer rounded-full border border-border p-2 text-foreground transition-colors hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:border-border disabled:hover:text-foreground"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M15 18l-6-6 6-6" /></svg>
              </button>
              <p class="text-center text-sm font-semibold uppercase tracking-widest text-accent" data-giornale-label />
              <button
                type="button"
                data-giornale-next
                aria-label="Giornata successiva"
                class="cursor-pointer rounded-full border border-border p-2 text-foreground transition-colors hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:border-border disabled:hover:text-foreground"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M9 18l6-6-6-6" /></svg>
              </button>
            </div>
            <div data-giornale-slides>
              {edizioniGiornale.map((edizione, index) => (
                <img
                  data-giornale-slide
                  data-giornata={edizione.settimana}
                  data-titolo={edizione.titolo}
                  src={withBase(`/quotidiani/${stagioneSlug}/${edizione.immagine}`)}
                  alt={edizione.titolo}
                  width="900"
                  loading={index === 0 ? "eager" : "lazy"}
                  class:list={["mx-auto w-full rounded-lg border border-border", { hidden: index !== 0 }]}
                />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>("[data-giornale]").forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLImageElement>("[data-giornale-slide]"));
    const label = root.querySelector<HTMLElement>("[data-giornale-label]");
    const prevButton = root.querySelector<HTMLButtonElement>("[data-giornale-prev]");
    const nextButton = root.querySelector<HTMLButtonElement>("[data-giornale-next]");
    let index = 0;

    function render() {
      slides.forEach((slide, i) => slide.classList.toggle("hidden", i !== index));
      const slide = slides[index];
      if (label && slide) {
        label.textContent = `Giornata ${slide.dataset.giornata} · ${slide.dataset.titolo}`;
      }
      if (prevButton) prevButton.disabled = index === slides.length - 1;
      if (nextButton) nextButton.disabled = index === 0;
    }

    prevButton?.addEventListener("click", () => {
      index = Math.min(index + 1, slides.length - 1);
      render();
    });
    nextButton?.addEventListener("click", () => {
      index = Math.max(index - 1, 0);
      render();
    });

    render();
  });
</script>
