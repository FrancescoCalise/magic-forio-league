---
import { Image } from "astro:assets";
import logo from "../assets/logo-magic-forio-cup.png";
import { withBase } from "../lib/url";

const links = [
  { href: "/", label: "Home" },
  { href: "/albo-oro", label: "Albo d'Oro" },
  { href: "/community", label: "Community" },
];

const currentPath = new URL(Astro.request.url).pathname;
---

<header class="sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a
      href={withBase("/")}
      class="flex items-center gap-2 font-display text-2xl tracking-wide text-foreground transition-colors hover:text-accent"
    >
      <Image
        src={logo}
        alt="Logo Magic Forio League"
        width={72}
        height={72}
        loading="eager"
        class="h-9 w-9"
      />
      MAGIC FORIO LEAGUE
    </a>
    <ul class="flex items-center gap-6">
      {
        links.map((link) => {
          const isActive = currentPath === withBase(link.href);
          return (
            <li>
              <a
                href={withBase(link.href)}
                class:list={[
                  "cursor-pointer text-sm font-semibold uppercase tracking-wide transition-colors",
                  isActive
                    ? "text-accent"
                    : "text-muted-foreground hover:text-foreground",
                ]}
                aria-current={isActive ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
